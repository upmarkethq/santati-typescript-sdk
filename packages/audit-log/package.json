{
  "name": "@santati/audit-log",
  "version": "0.1.0",
  "description": "Write and read Santati audit log events. Zero runtime dependencies.",
  "license": "MIT",
  "author": "James Carr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamescarr/santati-typescript-sdk.git",
    "directory": "packages/audit-log"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "publint": "publint",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "msw": "^2.10.4",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "santati",
    "audit-log",
    "audit",
    "logging",
    "compliance"
  ]
}
